{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elim-serviceportal-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "account_id": "7557223ab991a08ac213c7adf79966d9",
  "vars": {
    "APP_ENV": "local",
    "PUBLIC_SITE_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elim-serviceportal-local-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "elim-serviceportal-local-media"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "env": {
    "preview": {
      "name": "elim-serviceportal-preview",
      "routes": [
        {
          "pattern": "serviceportal.glennritter.de",
          "custom_domain": true,
          "zone_name": "glennritter.de"
        }
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "./public-preview",
        "run_worker_first": ["/api/*", "/admin", "/admin/*"]
      },
      "vars": {
        "APP_ENV": "preview",
        "PUBLIC_SITE_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "elim-serviceportal-test-db",
          "database_id": "2744e50d-35ba-4ffb-b76c-57a2fbc08396",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "elim-serviceportal-test-media"
        }
      ]
    },
    "test": {
      "name": "elim-serviceportal-test",
      "vars": {
        "APP_ENV": "test",
        "PUBLIC_SITE_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "elim-serviceportal-test-db",
          "database_id": "2744e50d-35ba-4ffb-b76c-57a2fbc08396",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "elim-serviceportal-test-media"
        }
      ]
    }
  }
}
