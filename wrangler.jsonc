{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elim-serviceportal-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "account_id": "7557223ab991a08ac213c7adf79966d9",
  "vars": {
    "APP_ENV": "local",
    "PUBLIC_SITE_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elim-serviceportal-local-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "elim-serviceportal-local-media"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "env": {
    "preview": {
      "name": "elim-serviceportal-preview",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "serviceportal.glennritter.de",
          "custom_domain": true,
          "zone_name": "glennritter.de"
        }
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "./public-preview",
        "run_worker_first": [
          "/api/*",
          "/admin",
          "/admin/*",
          "/media/*"
        ]
      },
      "vars": {
        "APP_ENV": "preview",
        "PUBLIC_SITE_ENABLED": "true",
        "PORTAL_MODE": "persistent",
        "CF_ACCESS_TEAM_DOMAIN": "cold-cell-4312.cloudflareaccess.com",
        "CF_ACCESS_AUD": "09b952547e3db140088512bab69da9305ebb6c02c4b3de89fbda61e99bf33d2a",
        "ADMIN_EMAILS": "glenn.ritter@elimgeesthacht.de",
        "MAIL_ENABLED": "true",
        "PUBLIC_HOSTNAME": "serviceportal.glennritter.de",
        "RESEND_FROM": "Serviceportal <anfrage@mail.ehrenamt.glennritter.de>",
        "MAIL_TEST_TO": "glenn.ritter@elimgeesthacht.de",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAF2tjPhVqCTCVgME"
      },
      "ratelimits": [
        {
          "name": "REQUEST_RATE_LIMITER",
          "namespace_id": "2100294101",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ],
      "triggers": {
        "crons": [
          "17 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "elim-serviceportal-test-db",
          "database_id": "2744e50d-35ba-4ffb-b76c-57a2fbc08396",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "elim-serviceportal-test-media"
        }
      ]
    },
    "test": {
      "name": "elim-serviceportal-test",
      "vars": {
        "APP_ENV": "test",
        "PUBLIC_SITE_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "elim-serviceportal-test-db",
          "database_id": "2744e50d-35ba-4ffb-b76c-57a2fbc08396",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "elim-serviceportal-test-media"
        }
      ]
    }
  }
}
