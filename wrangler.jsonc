{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elim-serviceportal-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "local",
    "PUBLIC_SITE_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elim-serviceportal-local-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "elim-serviceportal-local-media"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  }
}
